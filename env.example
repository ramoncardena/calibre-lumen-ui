# Lumen configuration — copy to .env (which is gitignored) and fill in.
# Precedence: CLI flags > environment variables > this file.

# AI assistant (optional): openai | anthropic | xai
LUMEN_AI_PROVIDER=
LUMEN_AI_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-sonnet-4-6 / grok-4)
LUMEN_AI_MODEL=
# Max characters of book text sent with "Send the book text" (default 250000)
LUMEN_AI_BOOK_CHARS=

# Google Books API key for metadata search (optional, avoids 429s)
LUMEN_GOOGLE_KEY=

# Calibre content-server credentials (only if auth is enabled)
LUMEN_CALIBRE_USER=
LUMEN_CALIBRE_PASSWORD=
